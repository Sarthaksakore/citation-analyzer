# ============================================================
# Citation Analyzer — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control (.env is in .gitignore).
# ============================================================

# --- Database ---
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./citation_analyzer.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/citation_db

# --- OpenAlex ---
# No key required; set your email to access the polite API pool
OPENALEX_EMAIL=your@email.com
OPENALEX_REQUEST_WORKERS=1

# --- Semantic Scholar ---
# Free API works without a key; register for higher rate limits
SEMANTIC_SCHOLAR_API_KEY=
S2_REQUEST_WORKERS=1
# Uncapped runs skip Semantic Scholar without a key unless explicitly enabled.
ENABLE_S2_UNCAPPED=false

# --- Crossref ---
# No key required; set mailto for polite pool access
CROSSREF_MAILTO=your@email.com
CROSSREF_REQUEST_WORKERS=2
# Uncapped runs keep OpenCitations DOI records without per-DOI Crossref calls.
ENRICH_CROSSREF_UNCAPPED=false

# --- Google Scholar ---
# Optional provider-backed lookup. SerpApi resolves the name to a Scholar profile
# and returns profile citation metrics plus article-level citation counts.
SERPAPI_KEY=
# Optional exact profile ID. If set, name matching is bypassed for this profile.
GOOGLE_SCHOLAR_AUTHOR_ID=
GOOGLE_SCHOLAR_AUTHOR_NAME=
# Maximum pagination pages per Scholar request (1000 is a safety ceiling).
SCHOLAR_MAX_PAGES=1000
# Concurrent citing-paper requests. Increase cautiously; provider quotas apply.
SCHOLAR_CITATION_WORKERS=2

# --- IEEE Xplore (institutional/paid) ---
IEEE_API_KEY=

# --- Scopus (institutional/paid) ---
SCOPUS_API_KEY=

# --- Web of Science (institutional/paid) ---
WOS_API_KEY=

# --- Security ---
# HMAC-SHA256 secret for signing citation-count summaries (integrity check).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be changed before any production deployment.
INTEGRITY_SECRET=change-me-to-a-random-64-char-hex-secret

# Secret key for general FastAPI session signing (future use)
SECRET_KEY=change-me-to-a-random-secret

# --- Rate Limiting ---
# Max requests per minute for the /search (citation pipeline) endpoint
RATE_LIMIT_PER_MINUTE=20

# Max requests per minute for all other endpoints (default)
RATE_LIMIT_DEFAULT=60

# Cache successful provider responses locally to avoid repeating identical API calls.
API_CACHE_TTL_SECONDS=900
API_CACHE_MAX_ENTRIES=4096
SCHOLAR_CACHE_TTL_SECONDS=900

# --- CORS ---
# Comma-separated list of allowed origins; use * for development only
ALLOWED_ORIGINS=*
